# Fallback configuration: local development against the Firebase Emulator Suite.
#
# These values are fake on purpose and safe to commit. The `demo-` project ID
# prefix puts the Firebase SDK in demo mode, where it refuses to talk to any
# real backend, so `npm run dev:emulators` works out of the box on a fresh clone.
#
# This lives in `.env` — the *lowest* priority file Vite loads — precisely so
# that a `.env.local` with real project keys overrides it in every mode. Beware:
# Vite's order is `.env.[mode].local` > `.env.[mode]` > `.env.local` > `.env`,
# so putting these defaults in `.env.development` would silently win over
# `.env.local` during `npm run dev`.

VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-me-mories.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-me-mories
VITE_FIREBASE_STORAGE_BUCKET=demo-me-mories.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

VITE_USE_FIREBASE_EMULATORS=true
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
VITE_AUTH_EMULATOR_PORT=9099
VITE_FIRESTORE_EMULATOR_PORT=8080
