# Copy to .env.local and fill in with a real Firebase project's web app config
# (Firebase console → Project settings → Your apps → SDK setup and configuration).
#
# .env.local is git-ignored and takes priority over the demo defaults in .env,
# so dropping this file in place is all it takes to switch from the emulators to
# a real project — in both `npm run dev` and `npm run build`.
#
# It does NOT affect `npm test`: .env.test is mode-specific and therefore wins,
# which keeps the test suite away from your real project on purpose.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to true to route auth and Firestore to the local Emulator Suite.
VITE_USE_FIREBASE_EMULATORS=false
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
VITE_AUTH_EMULATOR_PORT=9099
VITE_FIRESTORE_EMULATOR_PORT=8080
