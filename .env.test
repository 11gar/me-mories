# Vitest runs in mode "test", so it loads this file rather than .env.development.
# Values are fake: tests never reach a real backend.

VITE_FIREBASE_API_KEY=test-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-me-mories.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-me-mories
VITE_FIREBASE_STORAGE_BUCKET=demo-me-mories.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

VITE_USE_FIREBASE_EMULATORS=false
