rules_version = '2';

// Me'Mories — security rules.
//
// Two guarantees, in order of importance:
//   1. Isolation. Every document lives under /users/{uid}, so a user can only
//      ever reach their own data. There is no shared collection to leak from.
//   2. Shape. Firestore is schemaless, and the client is not a trusted place to
//      enforce a schema. A document that does not match the model is rejected
//      here, so a compromised or buggy client cannot poison the collection.
//
// Anything not explicitly allowed below is denied: Firestore's default is deny.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- helpers

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isNonEmptyString(value, maxLength) {
      return value is string && value.size() > 0 && value.size() <= maxLength;
    }

    function isNullableTimestamp(value) {
      return value == null || value is timestamp;
    }

    function isIdList(value, maxLength) {
      return value is list && value.size() <= maxLength;
    }

    // A civil day, never an instant: a timestamp would shift by a day depending
    // on the reader's timezone.
    function isCivilDate(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // createdAt is written once, at creation, and never again.
    function keepsCreatedAt() {
      return request.resource.data.createdAt == resource.data.createdAt;
    }

    function hasExactKeys(data, keys) {
      return data.keys().hasAll(keys) && data.keys().hasOnly(keys);
    }

    // ------------------------------------------------------------- validators

    function isValidMemory(d) {
      return hasExactKeys(d, [
               'text', 'createdAt', 'updatedAt', 'tagIds', 'dateTagIds',
               'deletedAt', 'lastReviewedAt', 'reviewCount', 'schemaVersion'
             ])
        && isNonEmptyString(d.text, 10000)
        && d.createdAt is timestamp
        && d.updatedAt is timestamp
        && isIdList(d.tagIds, 50)
        && isIdList(d.dateTagIds, 50)
        && isNullableTimestamp(d.deletedAt)
        && isNullableTimestamp(d.lastReviewedAt)
        && d.reviewCount is int && d.reviewCount >= 0
        && d.schemaVersion is int && d.schemaVersion >= 1;
    }

    function isValidTag(d) {
      return hasExactKeys(d, ['title', 'titleNormalized', 'color', 'createdAt', 'updatedAt'])
        && isNonEmptyString(d.title, 60)
        && isNonEmptyString(d.titleNormalized, 60)
        && d.color is string && d.color.matches('^#[0-9a-fA-F]{6}$')
        && d.createdAt is timestamp
        && d.updatedAt is timestamp;
    }

    function isValidDateTag(d) {
      return hasExactKeys(d, ['date', 'label', 'createdAt', 'updatedAt'])
        && isCivilDate(d.date)
        && (d.label == null || isNonEmptyString(d.label, 80))
        && d.createdAt is timestamp
        && d.updatedAt is timestamp;
    }

    // A repetition rule, stored as a nested map so each field can be checked
    // here rather than trusted inside an opaque string.
    function isValidRecurrence(r) {
      return r == null
        || (r is map
            && hasExactKeys(r, ['unit', 'interval'])
            && r.unit in ['day', 'week', 'month']
            && r.interval is int && r.interval >= 1 && r.interval <= 365);
    }

    function isValidTodo(d) {
      return hasExactKeys(d, [
               'title', 'dueDate', 'recurrence', 'status', 'tagIds', 'seriesId',
               'postponeCount', 'completedAt', 'createdAt', 'updatedAt',
               'deletedAt', 'schemaVersion'
             ])
        && isNonEmptyString(d.title, 280)
        && (d.dueDate == null || isCivilDate(d.dueDate))
        && isValidRecurrence(d.recurrence)
        // A rule with nothing to repeat from cannot produce a date; refusing it
        // here keeps the invariant true even for a client that forgot it.
        && (d.recurrence == null || d.dueDate != null)
        && d.status in ['todo', 'done', 'postponed']
        && isIdList(d.tagIds, 50)
        && (d.seriesId == null || isNonEmptyString(d.seriesId, 200))
        && d.postponeCount is int && d.postponeCount >= 0
        && isNullableTimestamp(d.completedAt)
        && d.createdAt is timestamp
        && d.updatedAt is timestamp
        && isNullableTimestamp(d.deletedAt)
        && d.schemaVersion is int && d.schemaVersion >= 1;
    }

    function isValidUserProfile(d) {
      return hasExactKeys(d, ['displayName', 'email', 'createdAt', 'updatedAt', 'settings'])
        && (d.displayName == null || isNonEmptyString(d.displayName, 80))
        && isNonEmptyString(d.email, 320)
        && d.createdAt is timestamp
        && d.updatedAt is timestamp
        && d.settings is map;
    }

    // ------------------------------------------------------------------ rules

    match /users/{userId} {
      // `get` only: the app never queries the /users collection itself.
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(request.resource.data);
      allow update: if isOwner(userId)
                    && isValidUserProfile(request.resource.data)
                    && keepsCreatedAt();
      // Account deletion is a server-side concern (it must cascade); never a
      // client write.
      allow delete: if false;

      match /memories/{memoryId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidMemory(request.resource.data);
        allow update: if isOwner(userId) && isValidMemory(request.resource.data) && keepsCreatedAt();
        // Hard delete stays available for emptying the trash; the app soft-deletes
        // first by setting `deletedAt`.
        allow delete: if isOwner(userId);
      }

      match /tags/{tagId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidTag(request.resource.data);
        allow update: if isOwner(userId) && isValidTag(request.resource.data) && keepsCreatedAt();
        allow delete: if isOwner(userId);
      }

      match /dateTags/{dateTagId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidDateTag(request.resource.data);
        allow update: if isOwner(userId) && isValidDateTag(request.resource.data) && keepsCreatedAt();
        allow delete: if isOwner(userId);
      }

      match /todos/{todoId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidTodo(request.resource.data);
        allow update: if isOwner(userId) && isValidTodo(request.resource.data) && keepsCreatedAt();
        // Hard delete stays available for emptying the trash; the app soft-deletes
        // first by setting `deletedAt`.
        allow delete: if isOwner(userId);
      }
    }
  }
}
