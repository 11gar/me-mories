{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "import", "jsx-a11y", "vitest", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "ignorePatterns": ["dist", "node_modules", "coverage"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    // Obsolete with the automatic JSX runtime (tsconfig "jsx": "react-jsx").
    "react/react-in-jsx-scope": "off",
    "typescript/consistent-type-imports": ["error", { "prefer": "type-imports" }],
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    // `info` is allowed for deliberate startup diagnostics (which Firebase
    // project is in use, for instance) — the kind of line that turns a
    // half-hour of guessing into a glance at the console.
    "no-console": ["warn", { "allow": ["info", "warn", "error"] }],
    "import/no-cycle": "error",
    // Side-effect imports are how stylesheets and test setup get loaded here.
    "import/no-unassigned-import": "off",
    // `role="list"` on a <ul> is redundant per spec, but Safari drops list
    // semantics as soon as `list-style: none` is applied — which the design
    // system does everywhere. Keeping the role is the accessible choice.
    "jsx-a11y/no-redundant-roles": ["error", { "ul": ["list"] }]
  },

  // ---------------------------------------------------------------------------
  // Architecture boundaries.
  //
  // The dependency rule is the backbone of this codebase, so it is enforced by
  // the linter rather than left to discipline:
  //
  //   pages / features  ->  store · search · ui · hooks
  //   store · search    ->  infrastructure · domain
  //   infrastructure    ->  domain
  //   domain            ->  (nothing)
  //   ui                ->  (nothing but itself)
  //
  // src/app is the composition root and is deliberately unrestricted: it is the
  // one place allowed to wire every layer together.
  // ---------------------------------------------------------------------------
  "overrides": [
    {
      // domain/ is the pure heart of the app: no framework, no backend, no UI.
      // This is what makes it testable without Firebase, and portable if the
      // backend ever changes.
      "files": ["src/domain/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/app/*",
                  "@/pages/*",
                  "@/features/*",
                  "@/ui/*",
                  "@/store/*",
                  "@/search/*",
                  "@/infrastructure/*",
                  "@/config/*",
                  "react",
                  "react-dom",
                  "react-router",
                  "firebase",
                  "firebase/*",
                  "@firebase/*",
                  "zustand",
                  "zustand/*",
                  "minisearch",
                  "motion",
                  "motion/*"
                ],
                "message": "Le domaine doit rester pur : uniquement @/domain, @/lib, zod et date-fns."
              }
            ]
          }
        ]
      }
    },
    {
      // lib/ holds framework-agnostic helpers. It sits below everything else.
      "files": ["src/lib/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/app/*",
                  "@/pages/*",
                  "@/features/*",
                  "@/ui/*",
                  "@/store/*",
                  "@/search/*",
                  "@/infrastructure/*",
                  "@/domain/*",
                  "@/config/*",
                  "firebase",
                  "firebase/*"
                ],
                "message": "lib/ est la couche la plus basse : elle ne dépend d'aucune autre couche applicative."
              }
            ]
          }
        ]
      }
    },
    {
      // ui/ is the design system: purely presentational, driven by props only.
      // It must stay reusable outside this app.
      "files": ["src/ui/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/app/*",
                  "@/pages/*",
                  "@/features/*",
                  "@/store/*",
                  "@/search/*",
                  "@/infrastructure/*",
                  "@/domain/*",
                  "@/config/*",
                  "firebase",
                  "firebase/*"
                ],
                "message": "Le design system est purement présentationnel : il se pilote par props, sans store ni métier."
              }
            ]
          }
        ]
      }
    },
    {
      // infrastructure/ adapts the outside world (Firebase) to the domain ports.
      // It knows nothing about React or the UI.
      "files": ["src/infrastructure/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/app/*",
                  "@/pages/*",
                  "@/features/*",
                  "@/ui/*",
                  "@/store/*",
                  "@/search/*",
                  "react",
                  "react-dom",
                  "react-router"
                ],
                "message": "L'infrastructure implémente les ports du domaine : pas de React, pas d'UI, pas de store."
              }
            ]
          }
        ]
      }
    },
    {
      // store/ and search/ own the read model. They consume infrastructure but
      // must never reach back up into the views.
      "files": ["src/store/**/*.{ts,tsx}", "src/search/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/app/*", "@/pages/*", "@/features/*", "@/ui/*"],
                "message": "Le store et l'index de recherche sont en dessous des vues : ils ne doivent jamais les importer."
              }
            ]
          }
        ]
      }
    },
    {
      // features/ and pages/ are the views. All writes go through store actions,
      // never straight to Firestore.
      "files": ["src/features/**/*.{ts,tsx}", "src/pages/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/infrastructure/*", "firebase", "firebase/*", "@firebase/*"],
                "message": "Les vues ne parlent jamais à Firestore directement : passe par une action du store ou un hook de feature."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/**/*.{test,spec}.{ts,tsx}", "src/test/**/*.{ts,tsx}", "tests/**/*.ts"],
      "rules": {
        "no-restricted-imports": "off",
        "no-console": "off",
        // assertFails/assertSucceeds from @firebase/rules-unit-testing are the
        // assertions in rules tests; there is no bare `expect` to find.
        "vitest/expect-expect": [
          "error",
          { "assertFunctionNames": ["expect", "assertFails", "assertSucceeds"] }
        ]
      }
    }
  ]
}
