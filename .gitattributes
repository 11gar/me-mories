# Normalise every text file to LF, in the repository and in the working copy.
#
# Prettier is configured with `endOfLine: "lf"`. Without this, Git's Windows
# default would check files out as CRLF, Prettier would rewrite them as LF, and
# `npm run format:check` would fail forever on an otherwise clean tree.
* text=auto eol=lf

# Binary assets must never be touched.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary

# Generated: keep it out of diffs and reviews, but still versioned.
package-lock.json -diff linguist-generated
